[Unit]
Description=Qwen2.5-0.5B privacy residual classifier v4 (llama-server)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/privacy-gateway
ExecStart=/opt/privacy-gateway/llama.cpp/build/bin/llama-server \
  -m /opt/privacy-gateway/v4/qwen2.5-0.5b-privacy-v4-f16.gguf \
  --host 127.0.0.1 \
  --port 8319 \
  -t 2 \
  -tb 2 \
  -c 1024 \
  --parallel 2 \
  --temp 0 \
  --repeat-penalty 1.0 \
  --no-webui \
  --alias qwen25-05b-privacy-v4
Restart=always
RestartSec=5
Nice=8
MemoryMax=3G
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
